# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Set DEBUG=False in production. Static files are then served by WhiteNoise.
# DEBUG=False

# OpenRouter API Configuration
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Artificial Analysis API Configuration
ARTIFICIAL_ANALYSIS_API_URL=https://artificialanalysis.ai/api/v2
ARTIFICIAL_ANALYSIS_API_KEY=your-artificial-analysis-api-key-here

# models.dev catalog (free public JSON — no API key required)
MODELS_DEV_API_URL=https://models.dev/api.json

# --- Production (container) -------------------------------------------------
# The 6-hourly catalog sync runs inside the app process. Leave it false when
# running more than one gunicorn worker, since each worker would otherwise run
# its own copy of the job. When false, trigger a sync out-of-band instead:
#   docker compose exec web python manage.py sync_all
ENABLE_SCHEDULER=false

# How often the in-process scheduler syncs, in hours (used only when
# ENABLE_SCHEDULER=true).
SYNC_INTERVAL_HOURS=6

# Run `migrate` on boot. Set false on replicas that scale past one container so
# migrations don't race; run them once as a separate job.
RUN_MIGRATIONS=true

# Seed the catalog on boot (runs `sync_all`). The in-process scheduler only
# fires every SYNC_INTERVAL_HOURS and is off by default, so without this a
# brand-new deploy serves an empty catalog until the first manual sync.
# Disable when a separate job or cron handles ingestion.
RUN_INITIAL_SYNC=true

# Gunicorn tuning. WEB_CONCURRENCY defaults to the container's CPU count,
# clamped to 2-8. Leave unset unless you need to override.
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

