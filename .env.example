# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# OpenRouter API Configuration
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Artificial Analysis API Configuration
ARTIFICIAL_ANALYSIS_API_URL=https://artificialanalysis.ai/api/v2
ARTIFICIAL_ANALYSIS_API_KEY=your-artificial-analysis-api-key-here

# models.dev catalog (free public JSON — no API key required)
MODELS_DEV_API_URL=https://models.dev/api.json

